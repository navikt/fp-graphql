<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>no.nav.foreldrepenger.graphql</groupId>
        <artifactId>graphql-root</artifactId>
        <version>0.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>graphql-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Foreldrepenger :: GraphQL Maven Plugin</name>
    <description>Maven plugin for generating Java classes from GraphQL schemas.</description>

    <properties>
        <version.maven-plugin-api>3.9.16</version.maven-plugin-api>
        <version.maven-core>3.9.16</version.maven-core>
        <version.maven-plugin-annotations>3.15.2</version.maven-plugin-annotations>
        <version.maven-plugin-plugin>3.15.2</version.maven-plugin-plugin>
        <version.freemarker>2.3.34</version.freemarker>
        <version.graphql-java>26.1</version.graphql-java>
    </properties>

    <dependencies>
        <!-- Maven plugin versions -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${version.maven-plugin-api}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${version.maven-core}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${version.maven-plugin-annotations}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Code generation dependencies -->
        <dependency>
            <groupId>com.graphql-java</groupId>
            <artifactId>graphql-java</artifactId>
            <version>${version.graphql-java}</version>
        </dependency>
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
            <version>${version.freemarker}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${version.maven-plugin-plugin}</version>
                <configuration>
                    <skipErrorNoDescriptorsFound>true</skipErrorNoDescriptorsFound>
                </configuration>
                <executions>
                    <execution>
                        <id>mojo-descriptor</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>descriptor</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
